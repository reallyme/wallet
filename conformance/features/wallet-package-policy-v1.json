{
  "schema_version": 1,
  "policy_id": "reallyme.wallet.package-policy.v1",
  "owner": "reallyme/wallet",
  "versioning": "lockstep",
  "release_version": "0.1.2",
  "maintainer_rust_toolchain": "1.99.0",
  "public_crate_msrv": "1.99",
  "authorized_public_packages": [
    "reallyme-wallet-types",
    "reallyme-wallet-keystore",
    "reallyme-wallet-lifecycle",
    "reallyme-wallet-log",
    "reallyme-wallet-attestation",
    "reallyme-wallet-storage",
    "reallyme-wallet-render",
    "reallyme-wallet-inventory",
    "reallyme-wallet-consent",
    "reallyme-wallet-proto",
    "reallyme-wallet-flows",
    "reallyme-wallet-proto-codec",
    "reallyme-wallet-zk",
    "reallyme-wallet-runtime",
    "reallyme-wallet-http",
    "reallyme-wallet-provider",
    "reallyme-wallet"
  ],
  "authorization_gate": {
    "state": "authorized_for_crates_io_release",
    "required_evidence": [
      "public_api_and_domain_serde_absence_audit",
      "all_non_registry_dependencies_published",
      "dependency_ordered_package_inspection",
      "locked_packaged_source_tests",
      "locked_crates_io_dry_run_without_upload",
      "semver_baseline"
    ]
  },
  "intended_rust_release_order": [
    ["reallyme-wallet-proto", "reallyme-wallet-types"],
    ["reallyme-wallet-lifecycle", "reallyme-wallet-render", "reallyme-wallet-zk"],
    ["reallyme-wallet-keystore"],
    ["reallyme-wallet-attestation"],
    ["reallyme-wallet-proto-codec"],
    ["reallyme-wallet-storage"],
    ["reallyme-wallet-inventory", "reallyme-wallet-log"],
    ["reallyme-wallet-consent"],
    ["reallyme-wallet-flows", "reallyme-wallet-runtime"],
    ["reallyme-wallet-http", "reallyme-wallet-provider"],
    ["reallyme-wallet"]
  ],
  "identity_composed_wasm_packages": [
    "reallyme-wallet-types",
    "reallyme-wallet-keystore",
    "reallyme-wallet-lifecycle",
    "reallyme-wallet-log",
    "reallyme-wallet-attestation",
    "reallyme-wallet-consent",
    "reallyme-wallet-proto-codec",
    "reallyme-wallet-storage",
    "reallyme-wallet-runtime",
    "reallyme-wallet-provider"
  ],
  "workspace_packages": [
    { "name": "reallyme-wallet", "manifest": "crates/wallet/Cargo.toml", "classification": "intended_rust_release", "publish": true },
    { "name": "reallyme-wallet-types", "manifest": "crates/types/Cargo.toml", "classification": "intended_rust_release", "publish": true },
    { "name": "reallyme-wallet-storage", "manifest": "crates/storage/Cargo.toml", "classification": "intended_rust_release", "publish": true },
    { "name": "reallyme-wallet-keystore", "manifest": "crates/keystore/Cargo.toml", "classification": "intended_rust_release", "publish": true },
    { "name": "reallyme-wallet-lifecycle", "manifest": "crates/lifecycle/Cargo.toml", "classification": "intended_rust_release", "publish": true },
    { "name": "reallyme-wallet-inventory", "manifest": "crates/inventory/Cargo.toml", "classification": "intended_rust_release", "publish": true },
    { "name": "reallyme-wallet-flows", "manifest": "crates/flows/Cargo.toml", "classification": "intended_rust_release", "publish": true },
    { "name": "reallyme-wallet-consent", "manifest": "crates/consent/Cargo.toml", "classification": "intended_rust_release", "publish": true },
    { "name": "reallyme-wallet-attestation", "manifest": "crates/attestation/Cargo.toml", "classification": "intended_rust_release", "publish": true },
    { "name": "reallyme-wallet-log", "manifest": "crates/log/Cargo.toml", "classification": "intended_rust_release", "publish": true },
    { "name": "reallyme-wallet-render", "manifest": "crates/render/Cargo.toml", "classification": "intended_rust_release", "publish": true },
    { "name": "reallyme-wallet-proto", "manifest": "crates/proto/Cargo.toml", "classification": "intended_rust_release", "publish": true },
    { "name": "reallyme-wallet-proto-codec", "manifest": "crates/proto-codec/Cargo.toml", "classification": "intended_rust_release", "publish": true },
    { "name": "reallyme-wallet-provider", "manifest": "crates/provider/Cargo.toml", "classification": "intended_rust_release", "publish": true },
    { "name": "reallyme-wallet-runtime", "manifest": "crates/runtime/Cargo.toml", "classification": "intended_rust_release", "publish": true },
    { "name": "reallyme-wallet-http", "manifest": "crates/http/Cargo.toml", "classification": "intended_rust_release", "publish": true },
    { "name": "reallyme-wallet-zk", "manifest": "crates/wallet-zk/Cargo.toml", "classification": "intended_rust_release", "publish": true },
    { "name": "reallyme-wallet-conformance", "manifest": "conformance/Cargo.toml", "classification": "repository_tooling", "publish": false }
  ],
  "product_package_ownership": {
    "owner": "reallyme/identity",
    "wallet_repository_contains_general_platform_bindings": false,
    "wallet_repository_publishes_swift": false,
    "wallet_repository_publishes_kotlin_or_android": false,
    "wallet_repository_publishes_typescript_or_npm": false,
    "wallet_repository_publishes_wasm_bindgen_api": false,
    "wallet_repository_publishes_cdylib_or_standalone_wasm": false,
    "final_composed_artifacts_published_by_wallet": false
  }
}
